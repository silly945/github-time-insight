{
  "manifest_version": 3,
  "name": "GitHub Time Insight",
  "version": "1.0.4",
  "description": "See where your GitHub time actually goes. Local only. No account, no upload, no tracking.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/shared.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GitHub Time Insight",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/dashboard.html",
        "src/dashboard.js",
        "src/dashboard.css",
        "src/shared.js",
        "src/popup.html",
        "src/popup.js",
        "src/content.css",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["https://github.com/*"]
    }
  ],
  "options_page": "src/dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}